{
  "name": "app-finanzas",
  "version": "0.1.0",
  "description": "App de escritorio para documentar ingresos, gastos, inversiones y lista de compras (CLP).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cl.appfinanzas.desktop",
    "productName": "App Finanzas",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/chart.js/dist/chart.umd.js",
      "package.json"
    ],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  }
}
